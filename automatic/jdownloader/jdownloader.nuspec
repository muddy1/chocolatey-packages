<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>jdownloader</id>
    <version>2.0.1</version>
    <title>JDownloader</title>
    <authors>AppWork GmbH, JDownloader Community</authors>
    <owners>muddy1</owners>
    <projectUrl>https://jdownloader.org/</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/muddy1/chocolatey-packages@master/icons/JDownloader.png</iconUrl>
    <packageSourceUrl>https://github.com/muddy1/chocolatey-packages/tree/master/automatic/jdownloader</packageSourceUrl>
    <licenseUrl>https://www.gnu.org/licenses/gpl-3.0.en.html</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Free, open-source download management tool</summary>
    <description>JDownloader is a free, open-source download management tool with a huge community of developers that makes downloading as easy and fast as it should be. This package delegates installation and package hash verification to the WinGet repository layer (AppWork.JDownloader).</description>
    <tags>jdownloader download-manager java winget</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
